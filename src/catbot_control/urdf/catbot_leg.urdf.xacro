<?xml version="1.0" ?>
<!-- Basic differential drive mobile base -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="catbot">
  <xacro:include filename="$(find catbot_leg_description)/urdf/robot.urdf" />
  <ros2_control name="ODrives" type="system">
    <hardware>
      <plugin>odrive_ros2_control_plugin/ODriveHardwareInterface</plugin>
      <param name="can">can0</param>
    </hardware>
    <joint name="a">
      <param name="node_id">3</param>
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="l">
      <param name="node_id">2</param>
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <transmission name="a_transmission">
      <plugin>transmission_interface/SimpleTransmission</plugin>
      <actuator name="actuator_a" role="actuator_a" />
      <joint name="a" role="a">
        <mechanical_reduction>-8.0</mechanical_reduction>
        <offset>0.0</offset>
      </joint>
    </transmission>
    <transmission name="l_transmission">
      <plugin>transmission_interface/SimpleTransmission</plugin>
      <actuator name="actuator_l" role="actuator_l" />
      <joint name="l" role="l">
        <mechanical_reduction>-8.0</mechanical_reduction>
        <offset>0.0</offset>
      </joint>
    </transmission>
  </ros2_control>
  <ros2_control name="IMU" type="sensor">
    <hardware>
      <plugin>icm20948_hardware/ICM20948Interface</plugin>
      <param name="i2c_device">/dev/i2c-7</param>
      <param name="i2c_address">105</param>
      <param name="reverse_accel">[true, false, false]</param>
      <param name="reverse_gyro">[false, true, true]</param>
    </hardware>
    <sensor name="imu">
      <state_interface name="orientation.x" />
      <state_interface name="orientation.y" />
      <state_interface name="orientation.z" />
      <state_interface name="orientation.w" />
      <state_interface name="angular_velocity.x" />
      <state_interface name="angular_velocity.y" />
      <state_interface name="angular_velocity.z" />
      <state_interface name="linear_acceleration.x" />
      <state_interface name="linear_acceleration.y" />
      <state_interface name="linear_acceleration.z" />
    </sensor>
  </ros2_control>
</robot>
