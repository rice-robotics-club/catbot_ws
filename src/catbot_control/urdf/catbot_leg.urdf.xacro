<?xml version="1.0" ?>
<!-- Basic differential drive mobile base -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="catbot">
  <xacro:include filename="$(find catbot_leg_description)/urdf/robot.urdf" />
  <ros2_control name="ODrives" type="system">
    <!-- <xacro:unless value="${use_mock_hardware}"> -->
      <hardware>
        <plugin>odrive_ros2_control_plugin/ODriveHardwareInterface</plugin>
        <param name="can">can0</param>
      </hardware>
    <!-- </xacro:unless> -->
    <!-- <xacro:if value="${use_mock_hardware}">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
        <param name="calculate_dynamics">true</param>
      </hardware>
    </xacro:if> -->
    <joint name="a">
      <param name="node_id">0</param>
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="l">
      <param name="node_id">1</param>
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>

    <transmission name="a_transmission">
      <plugin>transmission_interface/SimpleTransmission</plugin>
      <actuator name="actuator_a" role="actuator_a"/>
      <joint name="a" role="a">
        <mechanical_reduction>8.0</mechanical_reduction>
        <offset>0.0</offset>
      </joint>
    </transmission>

    <transmission name="l_transmission">
      <plugin>transmission_interface/SimpleTransmission</plugin>
      <actuator name="actuator_l" role="actuator_l"/>
      <joint name="l" role="l">
        <mechanical_reduction>8.0</mechanical_reduction>
        <offset>0.0</offset>
      </joint>
    </transmission>
  </ros2_control>
</robot>
